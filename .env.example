# Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# PostgreSQL/PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=project
DB_USERNAME=project
# Set a non-empty local value in .env.local. Never commit the real password.
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kakao API
KAKAO_API_KEY=

# GMS / LLM
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GMS_KEY=
GMS_MODEL=gpt-5.4-mini

# Google OIDC
GOOGLE_CLIENT_ID=

# JWT
JWT_SECRET=

# Firebase Cloud Messaging
FCM_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/ssafycommon-6de18-firebase-adminsdk-fbsvc-c4d200273a.json
